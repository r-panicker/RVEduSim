{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RVEduSim",
  "version": "24.143.0",
  "identifier": "io.github.r-panicker.rvedusim",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "RISC-V functional and HDL simulator",
    "longDescription": "A RISC-V simulator for teaching computer architecture: an assembler and C compiler front end, single-cycle, multi-cycle and pipelined datapath views, and HDL simulation of your own processor with Icarus Verilog or Verilator.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
